# SERVER CONFIGURATION
PORT=5000
NODE_ENV=development

# DATABASE CONFIGURATION
# Local: mongodb://127.0.0.1:27017/kapdecrm
# Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/kapdecrm?appName=MYPROJECTS
MONGO_URI=mongodb://localhost:27017/kaapde

# SECURITY / AUTHENTICATION
JWT_SECRET=your_jwt_secret_here

# EMAIL / SMTP CONFIGURATION (Uses CRM_EMAIL and CRM_PASS for nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
CRM_EMAIL=your_email@gmail.com
CRM_PASS=your_gmail_app_password

# SMS INTEGRATION
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# AI / ML SERVICES
ML_SERVICE_URL=http://localhost:8000
AI_PROVIDER=LocalAIProvider
AI_API_KEY=your_ai_api_key
